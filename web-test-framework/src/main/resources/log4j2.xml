<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Properties>
    <Property name="pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} | %-6level | %-12t | %-18c{1} | %msg%n</Property>
    <Property name="logDir">logs</Property>
  </Properties>

  <Appenders>
    <!-- Console level can be changed from CLI: -Dlog.console.level=INFO -->
    <Console name="Console" target="SYSTEM_OUT">
      <ThresholdFilter level="${sys:log.console.level:-DEBUG}" onMatch="ACCEPT" onMismatch="DENY"/>
      <PatternLayout pattern="${pattern}"/>
    </Console>

    <!-- New file every day: logs/test.log is rolled to logs/test-yyyy-MM-dd.log at midnight -->
    <RollingFile name="File" fileName="${logDir}/test.log" filePattern="${logDir}/test-%d{yyyy-MM-dd}.log">
      <PatternLayout pattern="${pattern}"/>
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
      </Policies>
    </RollingFile>
  </Appenders>

  <Loggers>
    <Logger name="org.openqa" level="warn"/>
    <Logger name="io.github.bonigarcia" level="info"/>
    <Logger name="org.apache.hc" level="warn"/>
    <Root level="debug">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Root>
  </Loggers>
</Configuration>
